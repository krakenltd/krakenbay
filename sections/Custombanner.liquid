{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #custombanner-{{ section.id }} {
    position: relative;
  }

  .custombanner__wrapper {
    max-width: 100%;
    overflow: hidden;
  }

  .custombanner__track {
    display: flex;
    flex-wrap: nowrap;
    transition: transform 0.4s ease;
  }

  .custombanner__item {
    flex: 0 0 100%;
  }

  .custombanner__image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .custombanner__image--desktop { display: none; }
  }

  @media screen and (min-width: 750px) {
    .custombanner__image--mobile { display: none; }
  }

  .custombanner__button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
  }

  .custombanner__button--prev {
    left: 12px;
  }

  .custombanner__button--next {
    right: 12px;
  }

  .custombanner__button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media screen and (max-width: 749px) {
    .custombanner__button {
      width: 30px;
      height: 30px;
    }
  }

  .custombanner__trust-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem 2.8rem;
    flex-wrap: wrap;
    padding: 1.4rem 2rem;
    background: #132d34;
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .custombanner__trust-strip span::before {
    content: '✓';
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-right: 0.8rem;
    border-radius: 50%;
    background: #22dacc;
    color: #132d34;
    font-size: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .custombanner__trust-strip {
      justify-content: flex-start;
      gap: 0.8rem 1.8rem;
      padding: 1.2rem 1.6rem;
      font-size: 1.2rem;
    }
  }
  
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div id="custombanner-{{ section.id }}">
      <div class="custombanner__wrapper">
        <div class="custombanner__track">
          {% for block in section.blocks %}
            <div class="custombanner__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">
              {% endif %}

              {% if block.settings.desktop_image != blank %}
                <img
                  src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
                  width="{{ block.settings.desktop_image.width }}"
                  height="{{ block.settings.desktop_image.height }}"
                  alt="{{ block.settings.desktop_image.alt | escape }}"
                  class="custombanner__image custombanner__image--desktop"
                  loading="lazy"
                >
              {% endif %}

              {% if block.settings.mobile_image != blank %}
                <img
                  src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                  alt="{{ block.settings.mobile_image.alt | escape }}"
                  class="custombanner__image custombanner__image--mobile"
                  loading="lazy"
                >
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <button class="custombanner__button custombanner__button--prev" type="button" aria-label="Previous slide">
          ‹
        </button>
        <button class="custombanner__button custombanner__button--next" type="button" aria-label="Next slide">
          ›
        </button>
      {% endif %}
    </div>
    <div class="custombanner__trust-strip" aria-label="Kraken Bay shopping benefits">
      <span>Fully tested</span>
      <span>3-month warranty</span>
      <span>UK-based support</span>
    </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var sectionEl = document.getElementById('custombanner-' + sectionId);
    if (!sectionEl) return;

    var track = sectionEl.querySelector('.custombanner__track');
    if (!track) return;

    var items = sectionEl.querySelectorAll('.custombanner__item');
    if (!items.length) return;

    var prevBtn = sectionEl.querySelector('.custombanner__button--prev');
    var nextBtn = sectionEl.querySelector('.custombanner__button--next');

    var index = 0;
    var total = items.length;

    function goTo(newIndex) {
      index = (newIndex + total) % total;
      track.style.transform = 'translateX(' + (-index * 100) + '%)';
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        goTo(index - 1);
        resetTimer();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        goTo(index + 1);
        resetTimer();
      });
    }

    var autoRotate = {{ section.settings.auto_rotate | default: false | json }};
    var intervalSeconds = {{ section.settings.auto_rotate_interval | default: 5 }};
    var timer = null;

    function startTimer() {
      if (!autoRotate || total < 2) return;
      stopTimer();
      timer = setInterval(function() {
        goTo(index + 1);
      }, intervalSeconds * 1000);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function resetTimer() {
      stopTimer();
      startTimer();
    }

    sectionEl.addEventListener('mouseenter', stopTimer);
    sectionEl.addEventListener('mouseleave', startTimer);

    // init
    goTo(0);
    startTimer();
  })();
</script>

{% schema %}
{
  "name": "Custom banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_rotate_interval",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Change slide every",
      "default": 5
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Custom banner" }
  ]
}
{% endschema %}
