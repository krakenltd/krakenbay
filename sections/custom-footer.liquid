            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/googlepay.png?v=1743806351" width="20" height="20"
 alt="Google Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/klarna.png?v=1743806350" width="20" height="20"
 alt="Klarna">
          </div>
        {% endif %}
      </div>

      <!-- COL 3 -->
      <div class="kb-footer__col kb-footer__col-3">
        {% if section.settings.col3_heading != blank %}<h3>{{ section.settings.col3_heading }}</h3>{% endif %}

        {% if section.settings.col3_menu != blank and section.settings.col3_menu.links.size > 0 %}
          <ul class="kb-footer__links">
            {% for l in section.settings.col3_menu.links %}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.col3_text != blank %}
          <div class="kb-footer__text rte">{{ section.settings.col3_text }}</div>
        {% endif %}

        {% if section.settings.col3_show_payments %}
          <div class="payment-icons" aria-label="Payment methods">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/visa.png?v=1743806350" width="20" height="20"
 alt="Visa">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/mastercard.png?v=1743806350" width="20" height="20"
 alt="Mastercard">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/paypal.png?v=1743806350" width="20" height="20"
 alt="PayPal">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/clearpay.png?v=1743806350" width="20" height="20"
 alt="Clearpay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/applepay.png?v=1743806350" width="20" height="20"
alt="Apple Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/googlepay.png?v=1743806351" width="20" height="20"
 alt="Google Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/klarna.png?v=1743806350" width="20" height="20"
 alt="Klarna">
          </div>
        {% endif %}
      </div>

      <!-- COL 4 -->
      <div class="kb-footer__col kb-footer__col-4">
        {% if section.settings.col4_heading != blank %}<h3>{{ section.settings.col4_heading }}</h3>{% endif %}

        {% if section.settings.col4_menu != blank and section.settings.col4_menu.links.size > 0 %}
          <ul class="kb-footer__links">
            {% for l in section.settings.col4_menu.links %}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.col4_text != blank %}
          <div class="kb-footer__text rte">{{ section.settings.col4_text }}</div>
        {% endif %}

        {% if section.settings.col4_show_payments %}
          <div class="payment-icons" aria-label="Payment methods">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/visa.png?v=1743806350" width="20" height="20"
 alt="Visa">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/mastercard.png?v=1743806350" width="20" height="20"
 alt="Mastercard">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/paypal.png?v=1743806350" width="20" height="20"
 alt="PayPal">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/clearpay.png?v=1743806350" width="20" height="20"
 alt="Clearpay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/applepay.png?v=1743806350" width="20" height="20"
 alt="Apple Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/googlepay.png?v=1743806351" width="20" height="20"
 alt="Google Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/klarna.png?v=1743806350" width="20" height="20"
 alt="Klarna">
          </div>
        {% endif %}
      </div>

      <!-- COL 5 -->
      <div class="kb-footer__col kb-footer__col-5">
        {% if section.settings.col5_heading != blank %}<h3>{{ section.settings.col5_heading }}</h3>{% endif %}

        {% if section.settings.col5_menu != blank and section.settings.col5_menu.links.size > 0 %}
          <ul class="kb-footer__links">
            {% for l in section.settings.col5_menu.links %}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.col5_text != blank %}
          <div class="kb-footer__text rte">{{ section.settings.col5_text }}</div>
        {% endif %}

        {% if section.settings.col5_show_payments %}
          <div class="payment-icons" aria-label="Payment methods">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/visa.png?v=1743806350" width="20" height="20"
 alt="Visa">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/mastercard.png?v=1743806350" width="20" height="20"
 alt="Mastercard">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/paypal.png?v=1743806350" width="20" height="20"
 alt="PayPal">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/clearpay.png?v=1743806350" width="20" height="20"
 alt="Clearpay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/applepay.png?v=1743806350" width="20" height="20"
 alt="Apple Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/googlepay.png?v=1743806351" width="20" height="20"
 alt="Google Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/klarna.png?v=1743806350" width="20" height="20"
 alt="Klarna">
          </div>
        {% endif %}
      </div>

      <!-- RIGHT IMAGE STACK -->
      {% if section.settings.show_image_column %}
        <div class="kb-footer__image-col" aria-label="Footer images">
          {% for i in (1..5) %}
            {% assign img_key = 'image_' | append: i %}
            {% assign link_key = 'image_' | append: i | append: '_link' %}
            {% assign img = section.settings[img_key] %}
            {% assign href = section.settings[link_key] %}

            {% if img != blank %}
              <div class="kb-footer__image-item">
                {% if href != blank %}
                  <a href="{{ href }}" class="kb-footer__image-link">
                    {{ img | image_url: width: 220 | image_tag: class: 'kb-footer__image', loading: 'lazy' }}
                  </a>
                {% else %}
                  {{ img | image_url: width: 220 | image_tag: class: 'kb-footer__image', loading: 'lazy' }}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>

  <style>
    .kb-footer-{{ section.id }}{
      background: #fff;
      border-top: 1px solid rgba(0,0,0,0.06);
      padding: 48px 0;
    }

    .kb-footer-{{ section.id }} .kb-footer__inner{
      max-width: 1400px;
      margin: 0 auto;
    }

    /* TOP newsletter row */
    .kb-footer-{{ section.id }} .kb-footer__top{
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: 28px;
      align-items: start;
      padding-bottom: 34px;
      margin-bottom: 34px;
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }

    .kb-footer-{{ section.id }} .kb-footer__newsletter-title{
      margin: 0 0 8px;
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #111;
      line-height: 1.15;
    }

    .kb-footer-{{ section.id }} .kb-footer__newsletter-sub{
      color: rgba(0,0,0,0.72);
      font-size: 16px;
      line-height: 1.6;
      max-width: 520px;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__row{
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 14px;
      align-items: center;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__field{
      position: relative;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__input{
      width: 100%;
      min-height: 54px;
      border-radius: 10px;
      border: 1px solid rgba(0,0,0,0.22);
      padding: 14px 46px 14px 16px;
      font-size: 16px;
      outline: none;
      background: #fff;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__input:focus{
      border-color: rgba(0,0,0,0.55);
      box-shadow: 0 0 0 3px rgba(0,0,0,0.08);
    }

    .kb-footer-{{ section.id }} .kb-newsletter__icon{
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(0,0,0,0.6);
      pointer-events: none;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__button{
      min-height: 54px;
      border-radius: 10px;
      border: none;
      background: #111;
      color: #fff;
      padding: 0 22px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__button:hover{
      opacity: 0.92;
    }

    .kb-footer-{{ section.id }} .kb-newsletter__msg{
      margin: 10px 0 0;
      font-size: 14px;
    }
    .kb-footer-{{ section.id }} .kb-newsletter__msg--success{ color: #0a7a2f; }
    .kb-footer-{{ section.id }} .kb-newsletter__msg--error{ color: #b00020; }

    /* GRID columns */
    .kb-footer-{{ section.id }} .kb-footer__grid{
      display: grid;
      grid-template-columns: repeat(5, minmax(140px, 1fr)) minmax(170px, 220px);
      gap: 34px;
      align-items: start;
    }

    .kb-footer-{{ section.id }} .kb-footer__col h3{
      margin: 0 0 14px;
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #111;
    }

    .kb-footer-{{ section.id }} .kb-footer__links{
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 10px;
    }

    .kb-footer-{{ section.id }} .kb-footer__links a,
    .kb-footer-{{ section.id }} .kb-footer__text a{
      color: rgba(0,0,0,0.78);
      text-decoration: none;
      font-size: 16px;
      line-height: 1.4;
    }

    .kb-footer-{{ section.id }} .kb-footer__links a:hover,
    .kb-footer-{{ section.id }} .kb-footer__text a:hover{
      text-decoration: underline;
      color: #111;
    }

    .kb-footer-{{ section.id }} .kb-footer__text{
      color: rgba(0,0,0,0.78);
      font-size: 16px;
      line-height: 1.6;
      margin-top: 10px;
    }

    /* Payment icons block */
    .kb-footer-{{ section.id }} .payment-icons{
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
      align-items: center;
    }

    .kb-footer-{{ section.id }} .payment-icons img{
      height: 20px;
      width: auto;
      display: block;
      border: 1px solid rgba(0,0,0,0.10);
      border-radius: 6px;
      padding: 4px 6px;
      background: #fff;
    }

    /* Social icons */
    .kb-footer-{{ section.id }} .kb-footer__social{
      display: flex;
      gap: 10px;
      margin-top: 14px;
      align-items: center;
      flex-wrap: wrap;
    }
    .kb-footer-{{ section.id }} .kb-footer__social a{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      background: rgba(0,0,0,0.06);
      transition: transform 0.12s ease, background 0.12s ease;
    }
    .kb-footer-{{ section.id }} .kb-footer__social a:hover{
      transform: translateY(-1px);
      background: rgba(0,0,0,0.10);
    }
    .kb-footer-{{ section.id }} .kb-footer__social img{
      width: 20px;
      height: 20px;
      object-fit: contain;
      display: block;
    }

    /* Image stack column */
    .kb-footer-{{ section.id }} .kb-footer__image-col{
      display: grid;
      gap: 12px;
      justify-items: end;
    }
    .kb-footer-{{ section.id }} .kb-footer__image{
      width: 100%;
      max-width: 220px;
      height: auto;
      display: block;
    }

    /* Responsive */
    @media (max-width: 989px){
      .kb-footer-{{ section.id }}{
        padding: 34px 0;
      }
      .kb-footer-{{ section.id }} .kb-footer__top{
        grid-template-columns: 1fr;
      }
      .kb-footer-{{ section.id }} .kb-footer__grid{
        grid-template-columns: 1fr 1fr;
      }
      .kb-footer-{{ section.id }} .kb-footer__image-col{
        grid-column: 1 / -1;
        justify-items: start;
        grid-auto-flow: column;
        grid-auto-columns: minmax(120px, 160px);
        overflow-x: auto;
        padding-top: 6px;
      }
    }

    @media (max-width: 520px){
      .kb-footer-{{ section.id }} .kb-footer__grid{
        grid-template-columns: 1fr;
      }
      .kb-footer-{{ section.id }} .kb-newsletter__row{
        grid-template-columns: 1fr;
      }
      .kb-footer-{{ section.id }} .kb-newsletter__button{
        width: 100%;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "KB Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop with hot drops"
    },
    {
      "type": "richtext",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "<p>Be the first to know about new arrivals, exclusive deals, and tech news that matters.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button text",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks — you’re signed up."
    },

    {
      "type": "header",
      "content": "Social icons"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons (Column 1)",
      "default": true
    },

    {
      "type": "header",
      "content": "Columns"
    },

    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column 1 menu"
    },
    {
