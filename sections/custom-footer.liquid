        {% endif %}

        {% if section.settings.col2_text != blank %}
          <div class="kb-footer__text rte">{{ section.settings.col2_text }}</div>
        {% endif %}

        {% if section.settings.col2_show_payments %}
          <div class="payment-icons" aria-label="Payment methods">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/visa.png?v=1743806350" width="20" height="20"
 alt="Visa">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/mastercard.png?v=1743806350" width="20" height="20"
