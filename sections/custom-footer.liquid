{% comment %}
  Kraken Bay – Custom Footer (Dawn)
  - Newsletter row (left text + right signup)
  - 5 columns (each can use a selected menu and/or rich text)
  - Per-column toggle for payment icons
  - Social icons toggle (hardcoded URLs + icon URLs you provided) shown in Column 1
  - Optional right image stack column (up to 5 images) with optional links (url settings have NO defaults to avoid schema errors)
{% endcomment %}

<section class="kb-footer-{{ section.id }}">
  <div class="kb-footer__inner page-width">

    {% if section.settings.show_newsletter %}
      <div class="kb-footer__top">
        <div class="kb-footer__newsletter-copy">
          <h2 class="kb-footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
          <div class="kb-footer__newsletter-sub rte">{{ section.settings.newsletter_subtext }}</div>
        </div>

        <div class="kb-footer__newsletter-form">
          {% form 'customer', class: 'kb-newsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="kb-newsletter-email-{{ section.id }}">Email</label>

            <div class="kb-newsletter__row">
              <div class="kb-newsletter__field">
                <input
                  id="kb-newsletter-email-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="kb-newsletter__input"
                  placeholder="{{ section.settings.newsletter_placeholder }}"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
                <span class="kb-newsletter__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 7.5V17c0 .83.67 1.5 1.5 1.5h13c.83 0 1.5-.67 1.5-1.5V7.5c0-.83-.67-1.5-1.5-1.5h-13C4.67 6 4 6.67 4 7.5Z" stroke="currentColor" stroke-width="1.6"/>
                    <path d="M5.5 8.2 12 12.6l6.5-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

              <button type="submit" class="kb-newsletter__button">
                {{ section.settings.newsletter_button }}
              </button>
            </div>

            {% if form.posted_successfully? %}
              <p class="kb-newsletter__msg kb-newsletter__msg--success">{{ section.settings.newsletter_success }}</p>
            {% endif %}

            {% if form.errors %}
              <p class="kb-newsletter__msg kb-newsletter__msg--error">{{ form.errors | default_errors }}</p>
            {% endif %}
          {% endform %}
        </div>
      </div>
    {% endif %}

    <div class="kb-footer__grid">

      <!-- COL 1 -->
      <div class="kb-footer__col kb-footer__col-1">
        {% if section.settings.col1_heading != blank %}
          <h3>{{ section.settings.col1_heading }}</h3>
        {% endif %}

        {% if section.settings.col1_menu != blank and section.settings.col1_menu.links.size > 0 %}
          <ul class="kb-footer__links">
            {% for l in section.settings.col1_menu.links %}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.col1_text != blank %}
          <div class="kb-footer__text rte">{{ section.settings.col1_text }}</div>
        {% endif %}

        {% if section.settings.show_social_icons %}
          <div class="kb-footer__social" aria-label="Social links">
            <a href="https://www.instagram.com/kraken.bay/" target="_blank" rel="noopener">
              <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/instagram-icone-icon.png?v=1771416150" width="20" height="20"
alt="Instagram">
            </a>
            <a href="https://x.com/Krakentechuk" target="_blank" rel="noopener">
              <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/X_icon_38f733e2-7c38-424f-b29e-3df762c4694a.png?v=1771416200" width="20" height="20"
 alt="X">
            </a>
            <a href="https://www.facebook.com/people/Kraken-Bay/61588530263439/" target="_blank" rel="noopener">
              <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/Facebookicon.png?v=1771416453" width="20" height="20"
 alt="Facebook">
            </a>
            <a href="https://www.youtube.com/@krakenltd" target="_blank" rel="noopener">
              <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/youtube.png?v=1771416540" width="20" height="20"
 alt="YouTube">
            </a>
          </div>
        {% endif %}

        {% if section.settings.col1_show_payments %}
          <div class="payment-icons" aria-label="Payment methods">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/visa.png?v=1743806350" width="20" height="20"
 alt="Visa">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/mastercard.png?v=1743806350" width="20" height="20"
 alt="Mastercard">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/paypal.png?v=1743806350" width="20" height="20"
 alt="PayPal">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/clearpay.png?v=1743806350" width="20" height="20"
 alt="Clearpay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/applepay.png?v=1743806350" width="20" height="20"
 alt="Apple Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/googlepay.png?v=1743806351" width="20" height="20"
 alt="Google Pay">
            <img src="https://cdn.shopify.com/s/files/1/0908/2948/8471/files/klarna.png?v=1743806350" width="20" height="20"
 alt="Klarna">
          </div>
        {% endif %}
      </div>

      <!-- COL 2 -->
      <div class="kb-footer__col kb-footer__col-2">
        {% if section.settings.col2_heading != blank %}<h3>{{ section.settings.col2_heading }}</h3>{% endif %}

        {% if section.settings.col2_menu != blank and section.settings.col2_menu.links.size > 0 %}
          <ul class="kb-footer__links">
            {% for l in section.settings.col2_menu.links %}
              <li><a href="{{ l.url }}">{{ l.title }}</a></li>
