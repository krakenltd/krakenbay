{%- assign cpu_collection = section.settings.collection -%}

<section
  id="CpuFinder-{{ section.id }}"
  class="kb-cpu-finder"
  data-cpu-finder
  data-collection-handle="{{ cpu_collection.handle }}"
  data-max-items="{{ section.settings.products_to_show | default: 250 | at_most: 250 }}"
>
  <div class="page-width">
    <div class="kb-cpu-finder__shell">
      <header class="kb-cpu-finder__header">
        <div class="kb-cpu-finder__heading">
          <span class="kb-cpu-finder__eyebrow">Find your processor</span>
          <h2>{{ section.settings.banner_heading | default: 'Shop our CPUs' | escape }}</h2>
          <p>Search by model, choose Intel or AMD, then narrow the results by socket. Check your motherboard specification before ordering.</p>
          {%- if cpu_collection != blank -%}
            <a href="{{ cpu_collection.url }}" class="kb-cpu-finder__all-link">View every processor <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </div>

        {%- if section.settings.banner_image != blank -%}
          <a class="kb-cpu-finder__visual" href="{% if section.settings.banner_link != blank %}{{ section.settings.banner_link }}{% elsif cpu_collection != blank %}{{ cpu_collection.url }}{% endif %}" tabindex="-1" aria-hidden="true">
            {{ section.settings.banner_image | image_url: width: 900 | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 990px) 36vw, 100vw',
              class: 'kb-cpu-finder__image'
            }}
          </a>
        {%- endif -%}
      </header>

      <div class="kb-cpu-finder__controls">
        <div class="kb-cpu-finder__search">
          <label for="CpuSearch-{{ section.id }}">Search processors</label>
          <div class="kb-cpu-finder__search-box">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/></svg>
            <input id="CpuSearch-{{ section.id }}" type="search" placeholder="Try i5-8500, Ryzen 5 or LGA1151" autocomplete="off" data-cpu-search>
          </div>
        </div>

        {%- assign filter_rows = 'row1,row2,row3,row4,row5' | split: ',' -%}
        {%- for row in filter_rows -%}
          {%- assign row_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'filter' and block.settings.filter_row == row -%}{%- assign row_count = row_count | plus: 1 -%}{%- endif -%}
            {%- if block.type == 'type_filter' and block.settings.type_row == row -%}{%- assign row_count = row_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}

          {%- if row_count > 0 -%}
            <fieldset class="kb-cpu-finder__filter-set{% if forloop.index > 2 %} kb-cpu-finder__filter-set--secondary{% endif %}" data-filter-row="{{ row }}">
              <legend>{% if row == 'row1' %}1. Choose a brand{% elsif row == 'row2' %}2. Choose a socket <small>(optional)</small>{% else %}Refine results{% endif %}</legend>
              <div class="kb-cpu-finder__pills">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'filter' and block.settings.filter_row == row -%}
                    <button type="button" class="kb-cpu-finder__pill{% if block.settings.filter_image != blank %} kb-cpu-finder__pill--brand{% endif %}" data-filter-button data-filter-kind="brand" data-filter-value="{{ block.settings.filter_tag | strip | downcase | escape }}" aria-pressed="false" {{ block.shopify_attributes }}>
                      {%- if block.settings.filter_image != blank -%}
                        <span class="kb-cpu-finder__brand-logo">{{ block.settings.filter_image | image_url: width: 140 | image_tag: loading: 'lazy', class: 'kb-cpu-finder__brand-image' }}</span>
                      {%- endif -%}
                      <span>{{ block.settings.filter_label | escape }}</span>
                    </button>
                  {%- elsif block.type == 'type_filter' and block.settings.type_row == row -%}
                    <button type="button" class="kb-cpu-finder__pill" data-filter-button data-filter-kind="type" data-filter-value="{{ block.settings.type_value | strip | downcase | escape }}" aria-pressed="false" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.type_label | escape }}</span>
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="kb-cpu-finder__results-head">
        <div>
          <span class="kb-cpu-finder__status" data-cpu-status aria-live="polite">Loading processors…</span>
          <span class="kb-cpu-finder__hint">Select a card to see full specifications</span>
        </div>
        <div class="kb-cpu-finder__result-actions">
          <button type="button" class="kb-cpu-finder__clear" data-cpu-clear hidden>Clear filters</button>
          <button type="button" class="kb-cpu-finder__nav" data-cpu-prev aria-label="Previous processors" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="kb-cpu-finder__nav kb-cpu-finder__nav--next" data-cpu-next aria-label="Next processors" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="kb-cpu-finder__products" data-cpu-products aria-busy="true">
        {%- for i in (1..4) -%}<div class="kb-cpu-finder__skeleton" aria-hidden="true"><span></span><i></i><i></i></div>{%- endfor -%}
      </div>

      <div class="kb-cpu-finder__empty" data-cpu-empty hidden>
        <strong>No matching processors found</strong>
        <p>Try a shorter model number, remove a filter, or browse the full processor collection.</p>
        <button type="button" data-cpu-empty-clear>Reset search</button>
      </div>

      <div class="kb-cpu-finder__tip"><strong>Compatibility tip</strong><span>CPU sockets must match your motherboard exactly. The same processor family can use different sockets.</span></div>
    </div>
  </div>
</section>

{% stylesheet %}
.kb-cpu-finder{margin:clamp(5rem,8vw,10rem) 0;color:#101820}.kb-cpu-finder__shell{overflow:hidden;border:1px solid rgba(16,24,32,.12);border-radius:2.4rem;background:#f5f7f6;box-shadow:0 2rem 6rem rgba(16,24,32,.08)}.kb-cpu-finder__header{display:grid;grid-template-columns:1.1fr .9fr;min-height:34rem;background:#132d34;color:#fff}.kb-cpu-finder__heading{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(3rem,5vw,7rem)}.kb-cpu-finder__eyebrow{margin-bottom:1.6rem;color:#22dacc;font-size:1.15rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.kb-cpu-finder__heading h2{max-width:68rem;margin:0;color:#fff;font-size:clamp(3.8rem,5vw,6.5rem);line-height:.96;letter-spacing:-.05em}.kb-cpu-finder__heading p{max-width:62rem;margin:2rem 0;color:#c8d7d9;font-size:1.65rem;line-height:1.6}.kb-cpu-finder__all-link{color:#fff;font-weight:750;text-decoration:none}.kb-cpu-finder__all-link:hover{text-decoration:underline}.kb-cpu-finder__visual{display:block;min-height:30rem;overflow:hidden}.kb-cpu-finder__image{width:100%;height:100%;object-fit:cover}.kb-cpu-finder__controls{display:grid;grid-template-columns:minmax(26rem,.7fr) minmax(22rem,.55fr) minmax(0,1.75fr);gap:2rem;padding:3rem;border-bottom:1px solid rgba(16,24,32,.12)}.kb-cpu-finder__search label,.kb-cpu-finder__filter-set legend{display:block;margin:0 0 1rem;padding:0;font-size:1.25rem;font-weight:800;letter-spacing:.02em}.kb-cpu-finder__filter-set legend small{font-weight:500;color:#657178}.kb-cpu-finder__search-box{display:flex;align-items:center;height:5.4rem;padding:0 1.6rem;border:1px solid rgba(16,24,32,.16);border-radius:1.2rem;background:#fff;transition:border-color .2s,box-shadow .2s}.kb-cpu-finder__search-box:focus-within{border-color:#0c978d;box-shadow:0 0 0 3px rgba(34,218,204,.18)}.kb-cpu-finder__search-box svg{width:2rem;fill:none;stroke:currentColor;stroke-width:1.8}.kb-cpu-finder__search-box input{width:100%;height:100%;padding:0 1rem;border:0;outline:0;background:transparent;font:inherit}.kb-cpu-finder__filter-set{min-width:0;margin:0;padding:0;border:0}.kb-cpu-finder__filter-set--secondary{display:none}.kb-cpu-finder__pills{display:flex;gap:.8rem;overflow-x:auto;padding:0 0 .6rem;scrollbar-width:thin}.kb-cpu-finder__pill{flex:0 0 auto;min-height:4.4rem;padding:.9rem 1.4rem;border:1px solid rgba(16,24,32,.14);border-radius:999px;background:#fff;color:#26343a;font:inherit;font-size:1.3rem;font-weight:700;cursor:pointer;transition:background .18s,border-color .18s,transform .18s}.kb-cpu-finder__pill:hover{transform:translateY(-1px);border-color:#159d93}.kb-cpu-finder__pill[aria-pressed=true]{border-color:#132d34;background:#132d34;color:#fff}.kb-cpu-finder__pill--brand{min-width:10rem;flex-direction:column}.kb-cpu-finder__brand-logo{display:none}.kb-cpu-finder__results-head{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:2.2rem 3rem 1rem}.kb-cpu-finder__status{display:block;font-size:1.8rem;font-weight:800}.kb-cpu-finder__hint{display:block;margin-top:.25rem;color:#68747a;font-size:1.2rem}.kb-cpu-finder__result-actions{display:flex;align-items:center;gap:.8rem}.kb-cpu-finder__clear{margin-right:.6rem;padding:.8rem;border:0;background:transparent;color:#47565d;font-weight:700;text-decoration:underline;cursor:pointer}.kb-cpu-finder__nav{display:grid;place-items:center;width:4.4rem;height:4.4rem;border:1px solid rgba(16,24,32,.16);border-radius:50%;background:#fff;cursor:pointer}.kb-cpu-finder__nav--next{background:#132d34;color:#fff}.kb-cpu-finder__nav:disabled{opacity:.32;cursor:default}.kb-cpu-finder__nav svg{width:2rem;fill:none;stroke:currentColor;stroke-width:2}.kb-cpu-finder__products{display:flex;gap:1.4rem;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:1.5rem 3rem 3rem;scrollbar-width:none}.kb-cpu-finder__products::-webkit-scrollbar{display:none}.kb-cpu-finder__product-card{flex:0 0 calc((100% - 4.2rem)/4);min-width:22rem;scroll-snap-align:start}.kb-cpu-finder__product-card .card-wrapper,.kb-cpu-finder__product-card .card{height:100%}.kb-cpu-finder__product-card .card__media img{object-fit:contain!important}.kb-cpu-finder__skeleton{flex:0 0 calc((100% - 4.2rem)/4);min-width:22rem;padding:1.2rem;border-radius:1.2rem;background:#fff}.kb-cpu-finder__skeleton span{display:block;aspect-ratio:1;border-radius:.8rem;background:linear-gradient(90deg,#e8eceb,#f7f9f8,#e8eceb);background-size:200% 100%;animation:kbCpuPulse 1.4s infinite}.kb-cpu-finder__skeleton i{display:block;width:90%;height:1.2rem;margin-top:1.4rem;border-radius:1rem;background:#e1e6e4}.kb-cpu-finder__skeleton i:last-child{width:45%}@keyframes kbCpuPulse{to{background-position:-200% 0}}.kb-cpu-finder__empty{margin:1.5rem 3rem 3rem;padding:3rem;border:1px dashed rgba(16,24,32,.24);border-radius:1.4rem;text-align:center}.kb-cpu-finder__empty strong{font-size:2rem}.kb-cpu-finder__empty p{margin:1rem auto;max-width:52rem;color:#637178}.kb-cpu-finder__empty button{border:0;background:transparent;font-weight:800;text-decoration:underline;cursor:pointer}.kb-cpu-finder__tip{display:flex;gap:1.2rem;margin:0 3rem 3rem;padding:1.5rem 1.8rem;border-radius:1rem;background:#c9faf4;color:#294047;font-size:1.3rem}.kb-cpu-finder__tip strong{flex:none;color:#132d34}
@media(max-width:989px){.kb-cpu-finder__header{grid-template-columns:1fr}.kb-cpu-finder__visual{max-height:28rem}.kb-cpu-finder__controls{grid-template-columns:1fr 1fr}.kb-cpu-finder__search{grid-column:1/-1}.kb-cpu-finder__product-card,.kb-cpu-finder__skeleton{flex-basis:calc((100% - 1.4rem)/2)}}
@media(max-width:749px){.kb-cpu-finder{margin:5rem 0}.kb-cpu-finder .page-width{padding:0}.kb-cpu-finder__shell{border-radius:0;border-left:0;border-right:0}.kb-cpu-finder__header{min-height:0}.kb-cpu-finder__heading{padding:4rem 2rem}.kb-cpu-finder__heading h2{font-size:4.2rem}.kb-cpu-finder__heading p{font-size:1.5rem}.kb-cpu-finder__visual{min-height:20rem;max-height:23rem}.kb-cpu-finder__controls{grid-template-columns:1fr;gap:1.8rem;padding:2.2rem 1.6rem}.kb-cpu-finder__search{grid-column:auto}.kb-cpu-finder__pills{margin-right:-1.6rem;padding-right:1.6rem}.kb-cpu-finder__results-head{align-items:flex-end;padding:2rem 1.6rem 1rem}.kb-cpu-finder__hint{display:none}.kb-cpu-finder__clear{font-size:1.2rem}.kb-cpu-finder__nav{width:4rem;height:4rem}.kb-cpu-finder__products{padding:1rem 1.6rem 2.4rem}.kb-cpu-finder__product-card,.kb-cpu-finder__skeleton{flex-basis:78%;min-width:0}.kb-cpu-finder__tip{align-items:flex-start;flex-direction:column;gap:.4rem;margin:0 1.6rem 2.4rem}.kb-cpu-finder__empty{margin:1rem 1.6rem 2.4rem}}
{% endstylesheet %}

{% javascript %}
(function(){
  function normalise(value){return(value||'').toString().toLowerCase().replace(/[^a-z0-9]/g,'')}
  document.querySelectorAll('[data-cpu-finder]').forEach(function(section){
    if(section.dataset.ready==='true')return;
    section.dataset.ready='true';
    var scroller=section.querySelector('[data-cpu-products]');
    var search=section.querySelector('[data-cpu-search]');
    var status=section.querySelector('[data-cpu-status]');
    var clear=section.querySelector('[data-cpu-clear]');
    var empty=section.querySelector('[data-cpu-empty]');
    var emptyClear=section.querySelector('[data-cpu-empty-clear]');
    var prev=section.querySelector('[data-cpu-prev]');
    var next=section.querySelector('[data-cpu-next]');
    var buttons=Array.from(section.querySelectorAll('[data-filter-button]'));
    var cards=[];var active={};var loaded=false;var loading=false;

    function dataFor(card){if(card._cpuData)return card._cpuData;var tags=(card.dataset.productTags||'').toLowerCase();card._cpuData={tags:tags,vendor:(card.dataset.productVendor||'').toLowerCase(),type:(card.dataset.productType||'').toLowerCase(),text:normalise([card.textContent,tags,card.dataset.productVendor,card.dataset.productType].join(' '))};return card._cpuData}
    function matches(card){var data=dataFor(card);var query=normalise(search.value);if(query&&data.text.indexOf(query)===-1)return false;return Object.keys(active).every(function(row){var f=active[row];if(f.kind==='type')return data.type.indexOf(f.value)!==-1||data.tags.indexOf(f.value)!==-1;return data.vendor.indexOf(f.value)!==-1||data.tags.indexOf(f.value)!==-1})}
    function updateNav(){var max=scroller.scrollWidth-scroller.clientWidth;prev.disabled=scroller.scrollLeft<5;next.disabled=max<5||scroller.scrollLeft>max-5}
    function apply(){if(!loaded)return;var count=0;cards.forEach(function(card){var show=matches(card);card.hidden=!show;if(show)count++});var filtered=search.value.trim()||Object.keys(active).length;status.textContent=count+' processor'+(count===1?'':'s')+(filtered?' found':' available');empty.hidden=count!==0;scroller.hidden=count===0;clear.hidden=!filtered;requestAnimationFrame(updateNav)}
    function reset(){search.value='';active={};buttons.forEach(function(btn){btn.setAttribute('aria-pressed','false')});apply()}
    function load(){if(loaded||loading)return;loading=true;var handle=section.dataset.collectionHandle;if(!handle){status.textContent='Choose a processor collection in the theme editor';scroller.innerHTML='';return}var url='/collections/'+encodeURIComponent(handle)+'?view=kb-filter-json&page=1';fetch(url,{credentials:'same-origin'}).then(function(res){if(!res.ok)throw new Error('Unable to load');return res.text()}).then(function(html){var temp=document.createElement('div');temp.innerHTML=html;var incoming=Array.from(temp.querySelectorAll('[data-product-card]')).slice(0,parseInt(section.dataset.maxItems,10)||250);scroller.innerHTML='';incoming.forEach(function(card){scroller.appendChild(card)});cards=incoming;loaded=true;scroller.setAttribute('aria-busy','false');apply()}).catch(function(){scroller.innerHTML='';status.textContent='Processors could not be loaded';empty.hidden=false;empty.querySelector('strong').textContent='Unable to load processors'}).finally(function(){loading=false})}
    buttons.forEach(function(btn){btn.addEventListener('click',function(){var row=btn.closest('[data-filter-row]').dataset.filterRow;var was=btn.getAttribute('aria-pressed')==='true';section.querySelectorAll('[data-filter-row="'+row+'"] [data-filter-button]').forEach(function(other){other.setAttribute('aria-pressed','false')});if(was){delete active[row]}else{btn.setAttribute('aria-pressed','true');active[row]={kind:btn.dataset.filterKind,value:btn.dataset.filterValue}}apply()})});
    search.addEventListener('input',apply);clear.addEventListener('click',reset);emptyClear.addEventListener('click',reset);prev.addEventListener('click',function(){scroller.scrollBy({left:-Math.max(260,scroller.clientWidth*.8),behavior:'smooth'})});next.addEventListener('click',function(){scroller.scrollBy({left:Math.max(260,scroller.clientWidth*.8),behavior:'smooth'})});scroller.addEventListener('scroll',updateNav,{passive:true});
    if('IntersectionObserver'in window){var observer=new IntersectionObserver(function(entries){if(entries[0].isIntersecting){load();observer.disconnect()}},{rootMargin:'600px'});observer.observe(section)}else{load()}
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Filtered brand collection",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to search", "min": 10, "max": 1000, "step": 10, "default": 200 },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "url", "id": "banner_link", "label": "Banner link" },
    { "type": "text", "id": "banner_heading", "label": "Section title", "default": "Find the right processor" },
    { "type": "select", "id": "banner_position", "label": "Banner position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" }
  ],
  "blocks": [
    { "type": "filter", "name": "Tag / brand filter", "settings": [
      { "type": "text", "id": "filter_label", "label": "Label", "default": "Intel" },
      { "type": "text", "id": "filter_tag", "label": "Product tag to match", "default": "Intel" },
      { "type": "image_picker", "id": "filter_image", "label": "Filter image" },
      { "type": "select", "id": "filter_row", "label": "Filter row", "options": [{ "value": "row1", "label": "Row 1" }, { "value": "row2", "label": "Row 2" }, { "value": "row3", "label": "Row 3" }, { "value": "row4", "label": "Row 4" }, { "value": "row5", "label": "Row 5" }], "default": "row1" }
    ] },
    { "type": "type_filter", "name": "Type filter", "settings": [
      { "type": "text", "id": "type_label", "label": "Label", "default": "Desktop" },
      { "type": "text", "id": "type_value", "label": "Product type to match", "default": "Desktop" },
      { "type": "select", "id": "type_row", "label": "Filter row", "options": [{ "value": "row1", "label": "Row 1" }, { "value": "row2", "label": "Row 2" }, { "value": "row3", "label": "Row 3" }, { "value": "row4", "label": "Row 4" }, { "value": "row5", "label": "Row 5" }], "default": "row2" }
    ] }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Filtered brand collection", "category": "Collection" }]
}
{% endschema %}
