{"sections":{"custom_liquid_J8fwrb":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"kb-hero__features\">\n\n  <!-- Warranty -->\n  <div class=\"kb-feature\">\n    <div class=\"kb-feature__icon\">\n      <img src=\"https:\/\/drive.google.com\/thumbnail?id=1PTZldbOlgpsQPcGd9uPakCDJRw-27hRd&sz=w2000\" alt=\"Warranty icon\">\n    <\/div>\n    <div class=\"kb-feature__text\">\n      <strong>3-month warranty<\/strong>\n      <span>All items come with a 3-month warranty.<\/span>\n    <\/div>\n  <\/div>\n\n  <!-- Tested -->\n  <div class=\"kb-feature\">\n    <div class=\"kb-feature__icon\">\n      <img src=\"https:\/\/drive.google.com\/thumbnail?id=1BZ86LugvXIbt8gydQLK3H08QViX_5HHZ&sz=w2000\" alt=\"Tested icon\">\n    <\/div>\n    <div class=\"kb-feature__text\">\n      <strong>Fully tested<\/strong>\n      <span>All items fully tested to industry standards.<\/span>\n    <\/div>\n  <\/div>\n\n  <!-- UK customer service -->\n  <div class=\"kb-feature\">\n    <div class=\"kb-feature__icon\">\n      <img src=\"https:\/\/drive.google.com\/thumbnail?id=1lAF-A9xYSqLYQzTowMRdcvXuhZHflMpt&sz=w2000\" alt=\"UK customer service icon\">\n    <\/div>\n    <div class=\"kb-feature__text\">\n      <strong>UK customer service<\/strong>\n      <span>Friendly support from our UK-based team.<\/span>\n    <\/div>\n  <\/div>\n\n  <!-- Fast tracked shipping -->\n  <div class=\"kb-feature\">\n    <div class=\"kb-feature__icon\">\n      <img src=\"https:\/\/drive.google.com\/thumbnail?id=1XKxrw7Nck3mCWhin0FAAVdSDmGZ0-KHF&sz=w2000\" alt=\"Fast shipping icon\">\n    <\/div>\n    <div class=\"kb-feature__text\">\n      <strong>Fast-tracked shipping<\/strong>\n      <span>Fast-tracked shipping on all orders.<\/span>\n    <\/div>\n  <\/div>\n\n<\/div>\n\n<style>\n\/* Force real inset + prevent theme wrappers from cancelling padding *\/\n.kb-hero__features{\n  box-sizing: border-box;\n  background: #e6e8ee;\n  border-radius: 16px;\n\n  \/* THIS is the visible left gap *\/\n  padding: 10px 10px 10px 18px !important;\n\n  \/* Small outer breathing room *\/\n  margin: 10px 6px !important;\n\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n\/* Fallback: if the theme is still visually eating the left edge,\n   this guarantees the first item is never flush *\/\n.kb-hero__features > .kb-feature:first-child{\n  margin-left: 6px;\n}\n\n.kb-feature {\n  flex: 1 1 180px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n}\n\n.kb-feature__icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 10px;\n  background: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.kb-feature__icon img {\n  max-width: 55%;\n  max-height: 55%;\n}\n\n.kb-feature__text {\n  display: flex;\n  flex-direction: column;\n  font-size: 12px;\n  line-height: 1.2;\n}\n\n.kb-feature__text strong {\n  font-size: 13px;\n  margin-bottom: 1px;\n}\n\n.kb-feature__text span {\n  opacity: 0.75;\n}\n\n\/* Mobile: scroll row *\/\n@media (max-width: 768px) {\n  .kb-hero__features{\n    padding: 8px 12px 8px 14px !important;\n    margin: 0px 17px !important;\n\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    scroll-snap-type: x mandatory;\n    gap: 10px;\n\n    scrollbar-width: none;\n  }\n  .kb-hero__features::-webkit-scrollbar { display: none; }\n\n  .kb-hero__features > .kb-feature:first-child{\n    margin-left: 0; \/* not needed on mobile *\/\n  }\n\n  .kb-feature{\n    flex: 0 0 80%;\n    background: rgba(255,255,255,0.35);\n    border-radius: 12px;\n    padding: 8px;\n    scroll-snap-align: start;\n  }\n\n  .kb-feature__icon { width: 28px; height: 28px; }\n  .kb-feature__text { font-size: 11px; }\n  .kb-feature__text strong { font-size: 12px; }\n}\n.kb-hero__features { scroll-padding: 14px; }\n.kb-feature { scroll-margin-left: 14px; }\n<\/style>","color_scheme":"","padding_top":16,"padding_bottom":0}},"banner":{"type":"main-collection-banner","settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":36,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"adapt","image_shape":"default","show_secondary_image":false,"show_vendor":false,"show_rating":false,"quick_add":"none","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":36,"padding_bottom":36}}},"order":["custom_liquid_J8fwrb","banner","product-grid"]}