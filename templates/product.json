in-left: 0; /* not needed on mobile */\n  }\n\n  .kb-feature{\n    flex: 0 0 80%;\n    background: rgba(255,255,255,0.35);\n    border-radius: 12px;\n    padding: 8px;\n    scroll-snap-align: start;\n  }\n\n  .kb-feature__icon { width: 28px; height: 28px; }\n  .kb-feature__text { font-size: 11px; }\n  .kb-feature__text strong { font-size: 12px; }\n}\n.kb-hero__features { scroll-padding: 14px; }\n.kb-feature { scroll-margin-left: 14px; }\n\u003c/style\u003e","color_scheme":"","padding_top":16,"padding_bottom":0}},"main":{"type":"main-product","blocks":{"title":{"type":"title","settings":{}},"vendor":{"type":"text","settings":{"text":"{{ product.vendor }}","text_style":"uppercase"}},"price":{"type":"price","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","swatch_shape":"square"}},"quantity_selector":{"type":"quantity_selector","settings":{}},"description":{"type":"description","settings":{}},"share":{"type":"share","settings":{"share_label":"Share"}},"custom_liquid_HLDNfx":{"type":"custom_liquid","settings":{"custom_liquid":"\u003cstyle\u003e\n    .seller-card {\n        background: white;\n        padding: 14px; /* Slightly increased */\n        border-radius: 12px;\n        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08); /* More subtle */\n        width: 100%;\n        max-width: 360px; /* Increased to counter shadow effect */\n        font-family: Arial, sans-serif;\n        text-align: left;\n        display: flex;\n        flex-direction: column;\n    }\n    .seller-header {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n    }\n    .seller-logo {\n        width: 38px; /* Slightly larger */\n        height: auto;\n    }\n    .seller-text {\n        font-size: 12px;\n        color: #333;\n        line-height: 1.4;\n    }\n    .seller-text a {\n        color: #0073e6;\n        text-decoration: none;\n        font-weight: bold;\n        font-size: 13px;\n    }\n    .divider {\n        border-top: 1px 