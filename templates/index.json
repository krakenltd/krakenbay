_EUJ7dJ":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"\u003csection class=\"kb-landfill-banner\"\u003e\n  \u003cdiv class=\"kb-landfill-banner__inner\"\u003e\n    \u003c!-- Left: main copy --\u003e\n    \u003cdiv class=\"kb-landfill-banner__copy\"\u003e\n      \u003ch2\u003eKeep tech out of landfill.\u003c/h2\u003e\n      \u003cp\u003e\n        Every device you buy from Kraken Bay is one less item rotting in landfill\n        and one more bargain powering your setup.\n      \u003c/p\u003e\n\n      \u003ca href=\"/collections/all\" class=\"kb-landfill-banner__cta\"\u003e\n        Shop planet-friendly tech\n      \u003c/a\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Right: benefits card --\u003e\n    \u003cdiv class=\"kb-landfill-banner__card\"\u003e\n      \u003c!-- 01: Devices rescued --\u003e\n      \u003cdiv class=\"kb-landfill-feature\"\u003e\n        \u003cdiv class=\"kb-landfill-feature__icon\"\u003e\n          \u003cimg src=\"https://drive.google.com/thumbnail?id=1U-KGXEM3xOpqkp5oluWc-BEnlLF_55Qj\u0026sz=w2000\" alt=\"Device recycle icon\"\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"kb-landfill-feature__text\"\u003e\n          \u003cstrong\u003eDevices rescued from landfill\u003c/strong\u003e\n          \u003cspan\u003eWe recover and refurbish tech that would otherwise be scrapped.\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003c!-- 02: Circular recycling --\u003e\n      \u003cdiv class=\"kb-landfill-feature\"\u003e\n        \u003cdiv class=\"kb-landfill-feature__icon\"\u003e\n          \u003cimg src=\"https://drive.google.com/thumbnail?id=1UmAI0n7qhNcxbUcwNuP1551T4xmwy4Ci\u0026sz=w2000\" alt=\"Recycle logo\"\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"kb-landfill-feature__text\"\u003e\n          \u003cstrong\u003eCircular tech, not single-use\u003c/strong\u003e\n          \u003cspan\u003eYour purchase keeps quality hardware circulating instead of wasting away.\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003c!-- 03: Carbon footprint --\u003e\n      \u003cdiv class=\"kb-landfill-feature\"\u003e\n        \u003cdiv class=\"kb-landfill-feature__icon\"\u003e\n          \u003cimg src=\"https://drive.google.com/thumbnail?id=1IMfykGIC2iPFHqLoYBn0rYgHsGRrcbsB\u0026sz=w2000\" alt=\"Carbon footprint icon\"\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"kb-landfill-feature__text\"\u003e\n          \u003cstrong\u003eLower carbon footprint\u003c/strong\u003e\n          \u003cspan\u003eBuying refurbished uses far less carbon than manufacturing new devices.\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003c!-- 04: Business \u0026 school collections --\u003e\n      \u003cdiv class=\"kb-landfill-feature\"\u003e\n        \u003cdiv class=\"kb-landfill-feature__icon\"\u003e\n          \u003cimg src=\"https://drive.google.com/thumbnail?id=197a2m8eJYoSwocCGmAzIxPwQ-9g4QF_7\u0026sz=w2000\" alt=\"Devices icon\"\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"kb-landfill-feature__text\"\u003e\n          \u003cstrong\u003eFree UK collections available\u003c/strong\u003e\n          \u003cspan\u003eWork with Kraken IT Recycling to responsibly dispose of old equipment.\u003c/span\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003cstyle\u003e\n  .kb-landfill-banner {\n    background: #e7d4ff; /* soft purple like reference */\n    border-radius: 24px;\n    padding: 0; /* padding handled inside */\n    margin: 10px auto;\n    width: 95%;\n    max-width: 1300px;\n  }\n\n  .kb-landfill-banner__inner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px; /* smaller gap so icons side is wider */\n    padding: 50px 32px;\n    flex-wrap: wrap;\n  }\n\n  .kb-landfill-banner__copy {\n    flex: 0 1 35%; /* narrower left */\n  }\n\n  .kb-landfill-banner__card {\n    flex: 0 1 60%; /* wider icons section */\n    background: #fff;\n    border-radius: 22px;\n    padding: 20px 22px;\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);\n  }\n\n  .kb-landfill-banner__copy h2 {\n    font-size: 40px;\n    line-height: 1.1;\n    margin: 0 0 16px;\n    font-weight: 700;\n  }\n\n  .kb-landfill-banner__copy p {\n    font-size: 18px;\n    margin: 0 0 24px;\n    max-width: 420px;\n  }\n\n  .kb-landfill-banner__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 14px 26px;\n    background: #111;\n    color: #fff;\n    border-radius: 999px;\n    font-size: 16px;\n    font-weight: 600;\n    text-decoration: none;\n    border: 1px solid #111;\n    transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;\n  }\n\n  .kb-landfill-banner__cta:hover {\n    background: #fff;\n    color: #111;\n    transform: translateY(-1px);\n  }\n\n  .kb-landfill-feature {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n  }\n\n  .kb-landfill-feature__icon {\n    width: 44px;\n    height: 44px;\n    border-radius: 14px;\n    background: #f3f4ff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .kb-landfill-feature__icon img {\n    max-width: 60%;\n    max-height: 60%;\n  }\n\n  .kb-landfill-feature__text {\n    display: flex;\n    flex-direction: column;\n    font-size: 14px;\n  }\n\n  .kb-landfill-feature__text strong {\n    font-size: 15px;\n    margin-bottom: 2px;\n  }\n\n  .kb-landfill-feature__text span {\n    opacity: 0.85;\n  }\n\n  @media (max-width: 900px) {\n    .kb-landfill-banner {\n      width: 90%;\n      border-radius: 16px;\n    }\n\n    .kb-landfill-banner__inner {\n      flex-direction: column;\n      padding: 28px 20px;\n    }\n\n    .kb-landfill-banner__copy {\n      flex: 1 1 100%;\n    }\n\n    .kb-landfill-ban